@startuml sequencia
autonumber
actor Aluno
participant "Frontend SPA" as UI
participant "JwtAuthenticationFilter" as JwtFilter
participant "CandidaturaController" as Ctrl
participant "AccessGuard" as Guard
participant "CandidaturaService" as Svc
participant "GlobalExceptionHandler" as ExHandler
database "VagaMonitoriaRepository" as VagaRepo
database "UsuarioRepository" as UserRepo
database "CandidaturaRepository" as CandRepo
participant "Notificador" as Notif

Aluno -> UI : Submete formulário de candidatura
UI -> JwtFilter : POST /api/v1/candidaturas (Bearer JWT)
JwtFilter -> Ctrl : SecurityContext populado
Ctrl -> Guard : canCreateApplication(dto.alunoId(), auth)

alt Usuário não é o próprio aluno nem ADMIN
  Guard --> Ctrl : false
  Ctrl --> UI : HTTP 403 ACESSO_NEGADO
else Autorizado
  Guard --> Ctrl : true
  Ctrl -> Svc : criar(dto)
  Svc -> VagaRepo : findById(dto.vagaId())

  alt Vaga não existe
    VagaRepo --> Svc : Optional.empty()
    Svc --> ExHandler : RecursoNaoEncontradoException
    ExHandler --> UI : HTTP 404 Not Found
  else Status != ABERTA ou fora de [dataAbertura, dataEncerramento]
    VagaRepo --> Svc : VagaMonitoria
    Svc --> ExHandler : RegraNegocioException
    ExHandler --> UI : HTTP 409 Conflict
  else Vaga ABERTA dentro da janela
    VagaRepo --> Svc : VagaMonitoria
    Svc -> UserRepo : findById(dto.alunoId())

    alt Aluno não existe
      UserRepo --> Svc : Optional.empty()
      Svc --> ExHandler : RecursoNaoEncontradoException
      ExHandler --> UI : HTTP 404 Not Found
    else Aluno encontrado
      UserRepo --> Svc : Usuario (aluno)
      Svc -> CandRepo : existsByVagaIdAndAlunoId(vagaId, alunoId)

      alt Candidatura já existente
        CandRepo --> Svc : true
        Svc --> ExHandler : RegraNegocioException
        ExHandler --> UI : HTTP 409 Conflict
      else Primeira candidatura
        CandRepo --> Svc : false
        Svc -> CandRepo : save(new Candidatura(...))
        CandRepo --> Svc : Candidatura salva
        note right of Svc
          Notificações rodam dentro de
          IntegracaoExecutor.executarSemInterromper
          para não reverter o banco se o envio falhar.
        end note
        Svc -> Notif : notificar(aluno)
        Svc -> UserRepo : findById(vaga.getProfessorId())
        Svc -> Notif : notificar(professor)
        Svc --> Ctrl : CandidaturaResponseDTO
        Ctrl --> UI : HTTP 201 Created
        UI --> Aluno : Exibe confirmação com status PENDENTE
      end
    end
  end
end
@enduml
