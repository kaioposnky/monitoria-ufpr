# PostgreSQL local usado pelo backend. Copie para .env ou exporte as variáveis
# no shell; nunca coloque a senha real neste arquivo versionado.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/monitoria_ufpr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=defina-sua-senha-local

# Redis é opcional para desenvolvimento; o backend usa localhost:6379 por padrão.
APP_CACHE_REDIS_ENABLED=true
SPRING_DATA_REDIS_URL=redis://localhost:6379
