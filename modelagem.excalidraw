    },
    {
      "id": "Sr9Wvidjv7ai4Psl8q0yG",
      "type": "text",
      "x": 1537.2120598874885,
      "y": 1810.27276107544,
      "width": 1884.1278076171875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 330698723,
      "version": 38,
      "versionNonce": 339460813,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793279026202,
      "link": null,
      "locked": false,
      "text": "ORM (Object-Relational Mapping): É a técnica de fazer a ponte entre o paradigma orientado a objetos do Java e o modelo relacional SQL.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORM (Object-Relational Mapping): É a técnica de fazer a ponte entre o paradigma orientado a objetos do Java e o modelo relacional SQL.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aDSV9Y5NzQCfTKQG8uZDw",
      "type": "text",
      "x": 1539.516387827378,
      "y": 1878.5265298940471,
      "width": 2930.04345703125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1155626061,
      "version": 32,
      "versionNonce": 1343534851,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793279039983,
      "link": null,
      "locked": false,
      "text": "JPA (Jakarta Persistence API): É a especificação padrão do Java para ORM (um conjunto de regras e interfaces). O Spring Boot normalmente usa o Hibernate como a biblioteca que de fato implementa essas regras.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JPA (Jakarta Persistence API): É a especificação padrão do Java para ORM (um conjunto de regras e interfaces). O Spring Boot normalmente usa o Hibernate como a biblioteca que de fato implementa essas regras.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
